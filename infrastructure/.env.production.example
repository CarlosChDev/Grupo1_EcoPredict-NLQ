# Copy to infrastructure/.env.production only on docker-host.
# Do not commit .env.production. Store the sensitive values in GitHub Secrets
# and/or OCI Vault when the T03 deployment method is approved.

# Non-sensitive deployment variables (GitHub Environment Variables)
N8N_VERSION=1.107.4
BACKEND_IMAGE=registry.example.com/ecopredict/backend:immutable-tag
N8N_PUBLIC_HOST=n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/
GENERIC_TIMEZONE=America/Lima

# Sensitive deployment variables (GitHub Secrets / OCI Vault)
POSTGRES_USER=replace_with_production_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=replace_with_a_stable_64_character_hex_key
