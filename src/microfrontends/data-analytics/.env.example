# Mismos webhooks de n8n (FLUJO C) que ya usa Dashboard Ambiental — HU-03
# no crea flujos nuevos, reutiliza estos.

# URL del webhook GET /estaciones (Flujo C), para el "Resumen por distrito".
# Requiere que el workflow esté Activado. Usa la Production URL, no la de Test:
VITE_N8N_ESTACIONES_WEBHOOK_URL=http://localhost:5678/webhook-test/estaciones

# URL del webhook de n8n que devuelve el promedio horario de PM2.5/PM10 de
# las últimas 24h (mismo workflow FLUJO C). Usado por el gráfico de tendencia:
VITE_N8N_SERIE_HORARIA_WEBHOOK_URL=http://localhost:5678/webhook-test/estaciones/serie-horaria

# URL del webhook de n8n que devuelve las alertas del sistema (tabla
# alertas_anomalias, incluye `analisis_llm`). Usado por el panel de alertas:
VITE_N8N_ALERTAS_WEBHOOK_URL=http://localhost:5678/webhook-test/alertas

# Opcional: si el webhook de n8n exige un header X-API-Key, definilo aca.
# VITE_N8N_API_KEY=
