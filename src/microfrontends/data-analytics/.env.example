# Base de los webhooks del flujo de analítica en n8n. El panel llama a:
#   {base}/distritos, {base}/comparativo, {base}/ranking-eca,
#   {base}/patron-horario y {base}/resumen-ia
# Usa el nginx del servidor (puerto 80), que agrega los headers CORS; el
# puerto 5678 de n8n no es accesible desde fuera. Requiere el workflow Activado.
VITE_N8N_ANALITICA_BASE_URL=http://144.22.203.51/webhook/analitica

# Header X-API-Key que exige el webhook de n8n (Header Auth).
# No subas la clave real al repositorio: ponla solo en tu .env local y en Vercel.
VITE_N8N_API_KEY=
