# URL del webhook de n8n que recibe la consulta en lenguaje natural
# (workflow FLUJO B). Se usa aquí solo para el diagnóstico "Local":
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/nlq

# Opcional: URL del webhook de n8n desplegado en la nube. Alimenta el
# toggle Local/Producción de este panel:
# VITE_N8N_WEBHOOK_URL_PROD=http://144.22.203.51/webhook/nlq

# Opcional: si el webhook de n8n exige un header X-API-Key, definilo aca.
# VITE_N8N_API_KEY=
