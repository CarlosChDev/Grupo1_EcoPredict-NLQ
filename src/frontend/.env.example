# URL del webhook de n8n que recibe la consulta en lenguaje natural
# (workflow FLUJO B, ver src/n8n-workflows/FLUJO B.json). Requiere que el
# workflow esté Activado (toggle "Active" en la esquina superior derecha
# del editor de n8n):
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/nlq

# Alternativa mientras se edita el workflow SIN activar: usar la ruta de
# prueba, pero hay que pulsar "Listen for test event" antes de cada llamada
# (solo responde a una peticion por click):
# VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/nlq

# Opcional: si el webhook de n8n exige un header X-API-Key, definilo aca.
# Usado por el microfrontend "Estado del Sistema" para probar la conexion
# y (si existe) por nlqApi.ts. Si se deja vacio, se muestra "no configurada".
# VITE_N8N_API_KEY=

# Opcional: URL del webhook de n8n desplegado en la nube. Solo alimenta el
# toggle Local/Produccion del microfrontend "Estado del Sistema" para poder
# diagnosticar ese entorno - el chat NLQ real sigue usando VITE_N8N_WEBHOOK_URL.
# VITE_N8N_WEBHOOK_URL_PROD=http://144.22.203.51:5678/webhook/nlq
