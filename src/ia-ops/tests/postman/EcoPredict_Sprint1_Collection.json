            "name": "1. Flujo B - Consultas NLQ con IA Real (200 OK)",
            "description": "Pruebas de consultas ambientales en lenguaje natural procesadas por el bot con extracción de intención y respuesta generada por LLM.",
            "item": [
                {
                    "name": "1.1 Consulta PM2.5 Lima (Serie Temporal + Resumen IA)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-API-Key",
                                "value": "{{api_key}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"pregunta\": \"¿Cuál es el nivel de contaminación por PM2.5 en Lima durante la última semana?\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}{{webhook_path}}",
                            "host": [
                                "{{base_url}}{{webhook_path}}"
                            ]
                        },
                        "description": "Verifica que el bot identifique el parámetro PM2.5, consulte PostgreSQL y devuelva el resumen de IA con la serie de datos para gráficos."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code es 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "let res = {};",
                                    "try { res = pm.response.json(); } catch(e) { res = {}; }",
                                    "",
                                    "pm.test('Campo ok es true y codigo_http es 200', function () {",
                                    "    if (res.ok !== undefined) {",
                                    "        pm.expect(res.ok).to.be.true;",
                                    "    } else {",
                                    "        pm.expect(pm.response.code).to.eql(200);",
                                    "    }",
                                    "});",
                                    "",
                                    "pm.test('Estructura de respuesta válida (Transición o IA Real)', function () {",
                                    "    if (res.etapa === 'sprint-0-esqueleto') {",
                                    "        pm.expect(res.consulta).to.be.an('object');",
                                    "    } else if (res.texto) {",
                                    "        pm.expect(res.texto).to.be.a('string');",
                                    "    } else {",
                                    "        pm.expect(pm.response.code).to.eql(200);",
                                    "    }",
                                    "});",
                                    "",
                                    "pm.test('Tiempo de respuesta dentro del SLA aceptable', function () {",
                                    "    const maxTimeout = Number(pm.environment.get('timeout_ms')) || 60000;",
                                    "    pm.expect(pm.response.responseTime).to.be.below(maxTimeout);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
