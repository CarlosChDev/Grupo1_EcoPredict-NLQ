					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pregunta\": \"¿Cuál es el nivel de contaminación por PM2.5 en Lima durante la última semana?\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{webhook_path}}",
							"host": ["{{base_url}}{{webhook_path}}"]
						},
						"description": "Verifica que el bot identifique el parámetro PM2.5, consulte PostgreSQL y devuelva el resumen de IA con la serie de datos para gráficos."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code es 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const res = pm.response.json();",
									"",
									"pm.test('Campo ok es true y codigo_http es 200', function () {",
									"    pm.expect(res.ok).to.be.true;",
									"    pm.expect(res.codigo_http).to.eql(200);",
									"});",
									"",
									"pm.test('Estructura de respuesta válida (Transición o IA Real)', function () {",
									"    if (res.etapa === 'sprint-0-esqueleto') {",
									"        pm.expect(res.consulta).to.be.an('object');",
									"        pm.expect(res.consulta.pregunta).to.be.a('string');",
									"    } else {",
									"        pm.expect(res.texto).to.be.a('string');",
									"        pm.expect(res.parametro).to.be.oneOf(['pm25', 'pm10', 'no2', 'so2', 'o3', 'co']);",
									"    }",
									"});",
									"",
									"pm.test('Tiempo de respuesta dentro del SLA (< 5000 ms)', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(5000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
