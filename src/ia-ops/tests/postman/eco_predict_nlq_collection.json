					"name": "1.1 Consulta de calidad del aire (PM2.5)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pregunta\": \"¿Cuál es el nivel de PM2.5 en Lima durante la última semana?\",\n  \"ciudad\": \"Lima\",\n  \"parametro\": \"pm25\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{webhook_path}}",
							"host": ["{{base_url}}{{webhook_path}}"]
						},
						"description": "Consulta estándar de calidad del aire con todos los campos completos."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Validar código de respuesta HTTP",
									"pm.test('Status code es 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Parsear respuesta",
									"const response = pm.response.json();",
									"",
									"pm.test('Campo ok es true', function () {",
									"    pm.expect(response.ok).to.be.true;",
									"});",
									"",
									"pm.test('codigo_http es 200', function () {",
									"    pm.expect(response.codigo_http).to.eql(200);",
									"});",
									"",
									"pm.test('Contiene objeto consulta con pregunta, ciudad y parametro', function () {",
									"    pm.expect(response.consulta).to.be.an('object');",
									"    pm.expect(response.consulta.pregunta).to.be.a('string');",
									"    pm.expect(response.consulta.ciudad).to.eql('Lima');",
									"    pm.expect(response.consulta.parametro).to.eql('pm25');",
									"});",
									"",
									"pm.test('Contiene campo etapa', function () {",
									"    pm.expect(response.etapa).to.be.a('string');",
									"});",
									"",
									"pm.test('Contiene campo procesado_en con formato ISO', function () {",
									"    pm.expect(response.procesado_en).to.match(/^\\d{4}-\\d{2}-\\d{2}T/);",
									"});",
									"",
									"pm.test('Tiempo de respuesta menor a 5 segundos', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(5000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
