					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('El servidor no crashea', function () {",
									"    pm.expect(pm.response.code).to.not.eql(500);",
									"});",
									"",
									"const res = pm.response.json();",
