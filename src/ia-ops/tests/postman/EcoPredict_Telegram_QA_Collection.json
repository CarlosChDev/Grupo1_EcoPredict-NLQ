    {
      "name": "2. Despacho de Alertas Ambientales",
      "description": "Pruebas del webhook de notificación con análisis de IA a suscriptores.",
      "item": [
        {
          "name": "2.1 Despachar Alerta con analisis_llm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alerta_id\": 101,\n  \"estacion_id\": 8,\n  \"parametro\": \"pm25\",\n  \"valor_registrado\": 78.5,\n  \"severidad\": \"critica\",\n  \"analisis_llm\": \"¡Alerta ambiental! Pico anómalo de PM2.5 en Campo de Marte.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhook/notificar-telegram",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhook",
                "notificar-telegram"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta HTTP válida (200 o 204)', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
