      "name": "1. Comandos del Bot de Telegram",
      "description": "Pruebas de la máquina de estados de comandos del bot.",
      "item": [
        {
          "name": "1.1 Comando /start - Bienvenida y Menú",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"update_id\": 10001,\n  \"message\": {\n    \"message_id\": 1,\n    \"from\": {\n      \"id\": 123456789,\n      \"is_bot\": false,\n      \"first_name\": \"Ciudadano\"\n    },\n    \"chat\": {\n      \"id\": 123456789,\n      \"type\": \"private\"\n    },\n    \"text\": \"/start\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhook/telegram",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhook",
                "telegram"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 o mock simulado', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
