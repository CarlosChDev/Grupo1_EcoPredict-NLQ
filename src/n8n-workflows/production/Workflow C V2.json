        "options": {}
      },
      "id": "0f2c2a9b-7bdb-4f76-ab8b-de6f956c60f4",
      "name": "Webhook GET /estaciones",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -448,
        112
      ],
      "webhookId": "hu23-estaciones-get",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ZYEcYtEuMlYiH0qx",
          "name": "NLQ"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ultimas AS (\n  SELECT\n    e.id          AS estacion_id,\n    e.nombre      AS estacion_nombre,\n    e.latitud     AS estacion_lat,\n    e.longitud    AS estacion_lon,\n    e.zona        AS estacion_zona,\n    m.parametro   AS parametro,\n    m.valor       AS valor,\n    m.unidad      AS unidad,\n    m.medido_en   AS medido_en,\n    ROW_NUMBER() OVER (\n      PARTITION BY e.id, m.parametro\n      ORDER BY m.medido_en DESC\n    ) AS rn\n  FROM mediciones_aire m\n  JOIN estaciones e ON e.id = m.estacion_id\n)\nSELECT\n  estacion_id,\n  estacion_nombre,\n  estacion_lat,\n  estacion_lon,\n  estacion_zona,\n  parametro,\n  MAX(valor)     FILTER (WHERE rn = 1) AS valor,\n  MAX(unidad)    FILTER (WHERE rn = 1) AS unidad,\n  MAX(medido_en) FILTER (WHERE rn = 1) AS medido_en,\n  MAX(valor)     FILTER (WHERE rn = 2) AS valor_anterior\nFROM ultimas\nWHERE rn <= 2\nGROUP BY estacion_id, estacion_nombre, estacion_lat, estacion_lon, estacion_zona, parametro\nORDER BY estacion_id, parametro;",
        "options": {}
      },
      "id": "dcb5f4ca-890e-43b6-9eba-e535ab0258e7",
      "name": "Postgres - Última medición y anterior por estación y parámetro",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -224,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "HouqG0p271KQBRdB",
          "name": "nlq reader"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Agrupa las filas planas (una por estación+parámetro) en el contrato acordado con frontend\nconst rows = $input.all().map(i => i.json);\n\nconst estacionesMap = new Map();\n\nfor (const row of rows) {\n  const id = row.estacion_id;\n  if (!estacionesMap.has(id)) {\n    estacionesMap.set(id, {\n      id: id,\n      nombre: row.estacion_nombre,\n      zona: row.estacion_zona ?? null,\n      coordenadas: {\n        lat: row.estacion_lat,\n        lon: row.estacion_lon\n      },\n      mediciones: []\n    });\n  }\n  estacionesMap.get(id).mediciones.push({\n    parametro: row.parametro,\n    valor: row.valor,\n    valorAnterior: row.valor_anterior ?? null,\n    unidad: row.unidad,\n    medidoEn: row.medido_en\n  });\n}\n\nconst responseBody = {\n  estaciones: Array.from(estacionesMap.values()),\n  total_estaciones: estacionesMap.size,\n  generado_en: new Date().toISOString()\n};\n\nreturn [{ json: responseBody }];"
      },
      "id": "e5b56d20-0e2d-4283-94fc-bf21d3de09de",
      "name": "Formatear contrato de respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "382e796f-4219-4d20-982e-4d6c1f36df31",
      "name": "Responder 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const err = $input.first().json;\nreturn [{\n  json: {\n    error: true,\n    mensaje: 'Error al consultar las mediciones de estaciones.',\n    detalle: err.message || err.error || 'Error desconocido'\n  }\n}];"
      },
      "id": "0f5bb69c-b706-46ee-b401-217b92c561b4",
      "name": "Formatear error",
