    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  date_trunc('hour', medido_en) AS hora,\n  AVG(valor) FILTER (WHERE parametro = 'pm25') AS pm25,\n  AVG(valor) FILTER (WHERE parametro = 'pm10') AS pm10\nFROM mediciones_aire\nWHERE medido_en > now() - interval '24 hours'\nGROUP BY 1\nORDER BY 1;",
        "options": {}
      },
      "id": "b26bec48-1399-4b72-9fa1-c56a49f0005c",
      "name": "Postgres - Serie horaria PM2.5/PM10 (24h)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -224,
        528
      ],
      "credentials": {
        "postgres": {
          "id": "HouqG0p271KQBRdB",
          "name": "nlq reader"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst serie = rows.map(row => ({\n  hora: row.hora,\n  pm25: row.pm25 !== null ? Number(row.pm25) : null,\n  pm10: row.pm10 !== null ? Number(row.pm10) : null\n}));\n\nreturn [{ json: { serie } }];"
      },
