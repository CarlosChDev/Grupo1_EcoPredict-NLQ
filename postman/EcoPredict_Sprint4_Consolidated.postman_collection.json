							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 403 Forbidden por Lista Blanca\", function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"pm.test(\"Respuesta JSON estructurada de seguridad\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"});"
								]
							}
						}
					]
				}
			]
